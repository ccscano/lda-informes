[Unit]
Description=Resumen mensual de ventas y top productos (HiOffice) por Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=TZ=Europe/Madrid
WorkingDirectory=/home/ubuntu/presencia
ExecStart=/usr/bin/python3 /home/ubuntu/presencia/periodos.py --mes
