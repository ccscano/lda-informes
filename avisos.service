[Unit]
Description=Avisos por Telegram si un local va muy por debajo del mismo día de la semana pasada
After=network-online.target

[Service]
Type=oneshot
Environment=TZ=Europe/Madrid
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/lda/presencia
ExecStart=/usr/bin/python3 /home/lda/presencia/avisos.py
