[Unit]
Description=Tiempos de cocina de las cafeterías (HiOffice, Auditoría Cocina) por Telegram
After=network-online.target

[Service]
Type=oneshot
Environment=TZ=Europe/Madrid
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/lda/presencia
ExecStart=/usr/bin/python3 /home/lda/presencia/cocina.py
